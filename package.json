{
  "name": "tasneem",
  "version": "1.0.0",
  "private": true,
  "description": "تسنيم — المصحف الكامل والأذكار ومواقيت الصلاة",
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "quran": "node scripts/fetch-quran.mjs",
    "android": "npx cap add android && node scripts/prepare-android.mjs && npx cap sync android",
    "prepare-android": "node scripts/prepare-android.mjs",
    "sync": "npx cap sync android",
    "apk": "cd android && ./gradlew assembleDebug",
    "all": "npm run quran && npm run android && npm run apk"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}